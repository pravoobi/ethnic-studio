CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Not a secret — same value as CLOUDINARY_API_KEY. next-cloudinary's upload widget needs it
# client-side for signed uploads; only CLOUDINARY_API_SECRET must never be exposed.
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Postgres (Neon) — used for both local dev and prod, see docs/decisions.md. Create a free
# database at neon.tech. Use the POOLED connection string (the one with "-pooler" in the
# hostname) for DATABASE_URL — required for serverless (Vercel); a direct connection hits
# Neon's low connection limit / autosuspend cold-start under concurrent function invocations.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
# The DIRECT (non-pooled) connection string — only `prisma migrate` uses this.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
NEXT_PUBLIC_TRYON_URL=https://pravoobi.github.io/try-on
