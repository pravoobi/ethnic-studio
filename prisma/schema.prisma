generator client {
  provider = "prisma-client-js"
}

// Postgres (Neon), used for both local dev and prod — deliberately not the sqlite-dev/
// Turso-or-Neon-prod split CLAUDE.md originally described. Prisma 6 (no driver adapters,
// avoided on purpose when this project downgraded off Prisma 7 for the same complexity reason)
// needs one `provider` for the whole schema, and sqlite/postgresql migrations aren't
// interchangeable. The schema has nothing sqlite-specific, so unifying on one real Postgres
// database for both environments avoids provider drift between what's tested locally and what
// runs in prod. See docs/decisions.md.
// `url` is Neon's pooled (PgBouncer) endpoint — required for serverless (Vercel): each function
// invocation can open its own connection, and a direct connection quickly hits Neon's low
// concurrent-connection limit or its autosuspend cold-start. `directUrl` is only used by
// `prisma migrate`, which needs a real (non-pooled) session connection. See docs/decisions.md —
// found live: variant generation intermittently 500'd because the DB write after a successful
// (expensive) Cloudinary generation used the direct URL and failed under concurrent load.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Cloudinary structured metadata is the source of truth for garment attributes
// (category/color/fabric/occasion/status). Every derived URL (cutout, crops) is deterministic
// from publicId + lib/cloudinary/transforms.ts, and already generated/cached by the pipeline —
// so this table only tracks pipeline orchestration state, not asset attributes or URLs.
model Garment {
  id                  String    @id @default(cuid())
  publicId            String    @unique
  status              String    @default("processing")
  // null = generative variants (backgrounds/recolor) not generated yet — the dashboard must not
  // render or link those URLs until this is set, or it risks triggering render-time generation.
  variantsGeneratedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Rate-limiting state for POST /api/sign-upload (CLAUDE.md: "rate-limited upload route").
// Vercel functions are stateless/multi-instance, so an in-memory limiter wouldn't actually work
// in prod — this table is the shared state instead, with no new external dependency.
model UploadAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}
